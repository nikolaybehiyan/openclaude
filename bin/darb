#!/usr/bin/env node

import { existsSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath, pathToFileURL } from 'node:url'
import { homedir } from 'node:os'
import { spawnSync } from 'node:child_process'

// Darb implements the native service contract on its own origin.
const origin = 'https://ai.darbmind.ru'
process.env.CLAUDE_CODE_CUSTOM_OAUTH_URL = origin
process.env.ANTHROPIC_BASE_URL = origin
process.env.CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST = '1'
process.env.CLAUDE_CODE_GB_BASE_URL = origin
process.env.GROWTHBOOK_CLIENT_KEY = 'sdk-zAZezfDKGoZuXXKe'
process.env.CLAUDE_CONFIG_DIR ??= join(homedir(), '.darb')
process.env.DISABLE_AUTOUPDATER = '1'

// Node loads additional CA roots only at process startup. A local deployment
// can install its public CA in this CLI's config without disabling TLS checks.
const localCA = join(process.env.CLAUDE_CONFIG_DIR, 'ca.pem')
if (!process.env.NODE_EXTRA_CA_CERTS && existsSync(localCA)) {
  const child = spawnSync(process.execPath, [...process.execArgv, process.argv[1], ...process.argv.slice(2)], {
    stdio: 'inherit',
    env: { ...process.env, NODE_EXTRA_CA_CERTS: localCA },
  })
  if (child.error) throw child.error
  process.exit(child.status ?? 1)
}

const dist = join(dirname(fileURLToPath(import.meta.url)), '..', 'dist', 'darb', 'cli.mjs')
if (!existsSync(dist)) {
  console.error('Darb: CLI bundle is missing. Run bun run build:darb first.')
  process.exit(1)
}
await import(pathToFileURL(dist).href)
